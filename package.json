{
  "name": "johorstudio-gallery",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/server",
    "packages/shared"
  ],
  "scripts": {
    "build": "tsc -b apps/server",
    "typecheck": "tsc -b apps/server --pretty false && tsc -p tsconfig.test.json --pretty false",
    "test": "vitest run",
    "db:migrate": "npm run build && node apps/server/dist/migrate-cli.js",
    "start": "node apps/server/dist/index.js",
    "heic-check": "node scripts/heic-check.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "node-addon-api": "8.9.2",
    "node-gyp": "12.4.0",
    "typescript": "5.9.3",
    "vitest": "5.1.1"
  },
  "allowScripts": {
    "sharp@0.34.5": true
  }
}
