    "@sveltejs/kit": "2.70.4",
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "@types/node": "22.20.5",
    "cookie": "0.6.0",
    "msw": "2.15.0",
    "svelte": "5.59.1",
    "svelte-check": "4.7.8",
    "thumbhash": "0.1.1",
    "typescript": "5.9.3",
    "vite": "7.3.8",
    "vitest": "5.1.1"
  },
  "msw": {
