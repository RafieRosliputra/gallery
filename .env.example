# Copy to .env for local runs. Values below are fake placeholders — never commit a real .env.
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
APP_VERSION=0.1.0

# Postgres 16. Local example matches the docker command in README.
DATABASE_URL=postgres://gallery:gallery@localhost:55432/gallery_test

# Optional: override the SQL migration directory (default: ./db/migrations).
MIGRATIONS_DIR=db/migrations

# Read-only photo root. The app never writes under this directory.
SOURCE_ROOT=/data/source

# Writable app data (SQLite-free): thumbs live in DATA_DIR/thumbs/<derivKey>/.
DATA_DIR=/data/app

# Scanner + worker.
THUMB_CONCURRENCY=1
# 0 disables the periodic scan in the server process.
SCAN_INTERVAL_MIN=10
# Phase 1b only: expose /s/api/admin/status without auth. Never set in production.
ADMIN_OPEN=0

# Cloudflare R2 (S3 API). All four of endpoint/bucket/key id/secret must be set;
# otherwise thumbnails stay local and r2.upload is skipped cleanly.
R2_ENDPOINT=https://example-account.r2.cloudflarestorage.com
R2_BUCKET=gallery-thumbs
R2_ACCESS_KEY_ID=fake-access-key-id
R2_SECRET_ACCESS_KEY=fake-secret-access-key
R2_REGION=auto
