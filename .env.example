# Copy to .env for local runs. Values below are fake placeholders — never commit a real .env.
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
APP_VERSION=0.1.0

# Postgres 16. Local example matches the docker command in README.
DATABASE_URL=postgres://gallery:gallery@localhost:55432/gallery_test

# Optional: override the SQL migration directory (default: ./db/migrations).
MIGRATIONS_DIR=db/migrations

# Read-only photo root. The app never writes under this directory.
# Empty/missing: the API still runs but originals are unavailable.
SOURCE_ROOT=/data/source

# Writable app data: thumbs in DATA_DIR/thumbs/<derivKey>/, hot originals in
# DATA_DIR/hot/<derivKey> (phase 3).
DATA_DIR=/data/app

# Scanner + worker.
THUMB_CONCURRENCY=1
# 0 disables the periodic scan in the server process (admin rescan still works).
SCAN_INTERVAL_MIN=10
# Directory names skipped at any depth (case-insensitive). Replaces the default.
SCAN_EXCLUDE=immich,@eaDir,#recycle,.Recycle.Bin

# Month/folder buckets use this IANA zone.
TIMEZONE=Asia/Kuala_Lumpur
# Set to 0 only when Fastify is exposed directly without cloudflared/Worker.
TRUST_PROXY=1

# Prefix for `thumb`/`preview` URLs: "<THUMB_BASE>/<derivKey>/<size>.webp".
THUMB_BASE=/s/t

# Shared with the Cloudflare Worker (`wrangler secret put ORIGIN_SECRET`).
# When set, every request except /s/api/health must carry X-Origin-Secret.
ORIGIN_SECRET=fake-origin-secret

# Thumbnail upload mode:
#   off    = no R2, derivatives stay on NAS only
#   s3     = direct S3 API (R2_* below required)
#   worker = PUT WORKER_UPLOAD_URL/<key> with X-Upload-Secret (no R2 creds on NAS)
R2_MODE=off

# R2 (S3 API) only for R2_MODE=s3. All four of endpoint/bucket/key id/secret must be set.
R2_ENDPOINT=https://example-account.r2.cloudflarestorage.com
R2_BUCKET=gallery-thumbs
R2_ACCESS_KEY_ID=fake-access-key-id
R2_SECRET_ACCESS_KEY=fake-secret-access-key
R2_REGION=auto

# R2_MODE=worker. UPLOAD_SECRET must equal the Worker secret of the same name.
# Keep it out of argv, git and logs.
UPLOAD_SECRET=fake-upload-secret
WORKER_UPLOAD_URL=https://johorstudio.com/s/_r2
